# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → Data API). Only the anon PUBLIC key goes here — never
# the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chronicle voice transcription (Groq Whisper). Deliberately NOT prefixed with
# VITE_ — Vite only exposes VITE_* to the browser bundle, so an unprefixed name
# cannot be leaked into client code by accident. This key is read by the Supabase
# Edge Function in supabase/functions/transcribe-voice, which is the only thing
# that ever talks to Groq.
#
# Deployed Edge Functions do NOT read this file. For anything other than a local
# `supabase functions serve`, set it as a project secret instead:
#   supabase secrets set GROQ_API_KEY=your_key_here
GROQ_API_KEY=
