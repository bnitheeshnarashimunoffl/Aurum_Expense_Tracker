# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → Data API). Only the anon PUBLIC key goes here — never
# the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Chronicle voice transcription (Groq Whisper). Deliberately NOT prefixed with
# VITE_ — Vite only exposes VITE_* to the browser bundle, so an unprefixed name
# cannot be leaked into client code by accident. This key is read by the Supabase
# Edge Function in supabase/functions/transcribe-voice, which is the only thing
# that ever talks to Groq.
#
# Deployed Edge Functions do NOT read this file. For anything other than a local
# `supabase functions serve`, set it as a project secret instead:
#   supabase secrets set GROQ_API_KEY=your_key_here
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Web Push (notifications)
# ---------------------------------------------------------------------------
# Generate all three at once — the script writes them straight into .env.local
# rather than printing the private key:
#
#   npm run vapid
#
# VITE_VAPID_PUBLIC_KEY is the ONLY one of these that belongs in the browser.
# Web Push works by shipping the server's public key to the client, so this being
# in the bundle is the design, not a leak. It also has to be set in your Vercel
# project's environment variables, or the deployed app cannot subscribe at all.
VITE_VAPID_PUBLIC_KEY=

# The private half. Server-side only, forever. Same rule as GROQ_API_KEY: no
# VITE_ prefix, and deployed Edge Functions do not read this file, so it must
# also be set as a Supabase project secret:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VAPID_PRIVATE_KEY=

# A contact address for the push services (RFC 8292 requires one, and some of
# them check it). Your real email, prefixed with mailto:.
VAPID_SUBJECT=mailto:you@example.com

# A random string of your own choosing. The push-dispatch function is deployed
# with --no-verify-jwt so pg_cron can call it, and this header is what stops
# anyone else who finds the URL from making it send. It goes in TWO places:
#   supabase secrets set CRON_SECRET=your_random_string
#   ...and into supabase/notifications_cron.sql before you run it.
# Listed here only as a record of what you chose; nothing local reads it.
CRON_SECRET=
